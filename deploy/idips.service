[Unit]
Description=IDIPS Intelligent DNS & Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=idips
Group=idips
WorkingDirectory=/var/lib/idips
StateDirectory=idips
ExecStart=/usr/local/bin/idips -data /var/lib/idips
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
Restart=on-failure
RestartSec=3s
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
